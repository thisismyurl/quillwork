# Dev-only files excluded from the distributed WordPress.org zip.
# Everything listed here is documentation or tooling that ships in the repo
# but has no place in the installable theme package.

ARCHITECTURE.md
GUIDE.md
THEME-CHECK.md
DESIGN-UPLIFT.md
PILLARS.md
README.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
.distignore
.gitignore
.git
.github
assets/fonts/README.md
patterns/README.md
node_modules
package.json
package-lock.json
composer.json
composer.lock
phpcs.xml.dist
phpstan.neon

# Colophon build-time files — the core lives in a sibling dir, but the
# per-theme identity record and any copied tooling must stay out of the zip.
colophon
colophon.json
colophon.manifest.json
tools

# CLI-only dev tooling and the GitHub self-updater — functions.php guards
# each require with file_exists() so excluding them here is safe under
# WP-CLI too, not just on the front end.
inc/cli.php
inc/github-updater.php

# WordPress.org directory listing assets (banner/icon) — pushed to the SVN
# assets/ path by .github/workflows/deploy-wporg-assets.yml, never bundled
# into the installed theme itself
.wporg-assets/
