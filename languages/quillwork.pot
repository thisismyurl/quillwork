#. Theme Name of the theme
#: style.css
msgid "Quillwork"
msgstr ""

#. Theme URI of the theme
#: style.css
msgid "https://themes.thisismyurl.com/quillwork/"
msgstr ""

#. Description of the theme
#: style.css
msgid "An elegant, literary full-site-editing theme for writers, editors, and personal brands. Light Cormorant Garamond display headlines with italic accents, a calm Newsreader reading column, deep-teal and warm-ochre palette on a cream ground, numbered service cards, and gentle float accents that respect reduced-motion. Zero plugin dependencies, self-hosted OFL fonts, RTL-ready via CSS logical properties."
msgstr ""

#. Author of the theme
#: style.css
msgid "Christopher Ross"
msgstr ""

#. Author URI of the theme
#: style.css
msgid "https://thisismyurl.com/"
msgstr ""

